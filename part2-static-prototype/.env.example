# ---- Liferay source (defaults point at the public liferay.dev community site) ----
LIFERAY_URL=https://liferay.dev
LIFERAY_SITE_ID=14
LIFERAY_AUTH=none            # none | basic | oauth2
LIFERAY_USER=
LIFERAY_PASSWORD=
LIFERAY_OAUTH_CLIENT_ID=     # OAuth2 client-credentials app (Control Panel → OAuth2 Administration)
LIFERAY_OAUTH_CLIENT_SECRET=
SITE_MENU_NAME=Site Menu     # navigation menu used for the header
ASSET_ORIGIN=https://liferay.dev   # where /documents/... images are served from (portal or CDN)
PUBLIC_URL=https://static.example.com

# ---- Fetch ----
MAX_ITEMS=80                 # demo cap for blogs/documents; use --full-catalog... or raise it
FETCH_CONCURRENCY=4
FULL_RELIST_EVERY=8          # deletion sweep every N runs

# ---- AI (leave ANTHROPIC_API_KEY empty to run deterministic fallbacks) ----
ANTHROPIC_API_KEY=
AI_MODEL_CHEAP=claude-haiku-4-5    # confirm current IDs before the talk
AI_MODEL_SMART=claude-sonnet-4-5
AI_BUDGET_TOKENS=20000       # hard ceiling per cycle
AI_BATCH_SIZE=8              # posts per enrichment call
AI_REVIEW=0                  # 1 = post-build review gate

# ---- Deploy / purge / webhook ----
DEPLOY_CMD=                  # e.g. rsync -a --delete dist/ user@edge:/var/www/site/
PURGE_CMD=                   # e.g. ./schedule/purge-cloudflare.sh  (gets PURGE_URLS, PURGE_TAGS, PURGE_ALL)
WEBHOOK_PORT=8787
WEBHOOK_SECRET=change-me
WEBHOOK_DEBOUNCE_MS=30000
