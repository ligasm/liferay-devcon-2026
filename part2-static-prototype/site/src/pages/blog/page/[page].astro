---
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import { posts, POSTS_PER_PAGE } from '../../../lib/content';
export function getStaticPaths() {
  const pageCount = Math.ceil(posts.length / POSTS_PER_PAGE);
  return Array.from({ length: Math.max(0, pageCount - 1) }, (_, i) => ({ params: { page: String(i + 2) } }));
}
const n = Number(Astro.params.page);
const pageCount = Math.ceil(posts.length / POSTS_PER_PAGE);
const slice = posts.slice((n - 1) * POSTS_PER_PAGE, n * POSTS_PER_PAGE);
---
<Base title={`Blog · page ${n}`} cacheTags={['blog', 'blog-list']}>
  <h1>Blog</h1>
  <p class="meta">page {n} of {pageCount}</p>
  <div class="grid" data-pagefind-ignore>{slice.map((p) => <PostCard post={p} />)}</div>
  <nav class="pager">
    <a class="btn" href={n === 2 ? '/blog/' : `/blog/page/${n - 1}/`}>← Newer</a>
    {n < pageCount && <a class="btn" href={`/blog/page/${n + 1}/`}>Older →</a>}
  </nav>
</Base>
