<!--
S2 — JGroups stack for Cluster Link over unicast TCP with JDBC_PING discovery.
Nodes register themselves in the JGROUPSPING table of the Liferay database, so
autoscaled/ephemeral nodes discover each other without multicast or a static host
list (TCP_PING cannot add/remove members). The DB user needs CREATE TABLE once,
or create JGROUPSPING manually.

Referenced from portal-ext.properties:
  cluster.link.channel.properties.control=<path>/jdbc_ping.xml
  cluster.link.channel.properties.transport.0=<path>/jdbc_ping.xml
Per node JVM flags: -Djgroups.bind_addr=<node ip> -Djgroups.tcp.port=7800

UNVERIFIED — check learn.liferay.com (KB "Managing distributed cache in Liferay
DXP") for the exact protocol list that matches the JGroups version bundled with
your release; the stack below is the standard JGroups 5.x tcp.xml with PING
replaced by JDBC_PING and secured with AUTH like the shipped jgroups/secure/md5 files.
-->
<config xmlns="urn:org:jgroups"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="urn:org:jgroups http://www.jgroups.org/schema/jgroups.xsd">
    <TCP bind_addr="${jgroups.bind_addr:SITE_LOCAL}"
         bind_port="${jgroups.tcp.port:7800}"
         recv_buf_size="5M"
         send_buf_size="1M"
         max_bundle_size="64K"
         sock_conn_timeout="300"
         thread_pool.min_threads="0"
         thread_pool.max_threads="20"
         thread_pool.keep_alive_time="30000"/>

    <JDBC_PING connection_url="${jgroups.jdbc.url:jdbc:mysql://db:3306/lportal}"
               connection_username="${jgroups.jdbc.user:lportal}"
               connection_password="${jgroups.jdbc.password:CHANGE_ME}"
               connection_driver="${jgroups.jdbc.driver:com.mysql.cj.jdbc.Driver}"
               initialize_sql="CREATE TABLE JGROUPSPING (own_addr varchar(200) NOT NULL, cluster_name varchar(200) NOT NULL, ping_data varbinary(5000) DEFAULT NULL, PRIMARY KEY (own_addr, cluster_name))"
               remove_all_data_on_view_change="true"/>

    <MERGE3 min_interval="10000" max_interval="30000"/>
    <FD_SOCK2/>
    <FD_ALL3 timeout="40000" interval="5000"/>
    <VERIFY_SUSPECT2 timeout="1500"/>
    <pbcast.NAKACK2 use_mcast_xmit="false" xmit_interval="500"/>
    <UNICAST3 xmit_interval="500"/>
    <pbcast.STABLE desired_avg_gossip="50000" max_bytes="4M"/>
    <AUTH auth_class="org.jgroups.auth.MD5Token" auth_value="${jgroups.auth.value:liferay-cluster}" token_hash="MD5"/>
    <pbcast.GMS print_local_addr="true" join_timeout="2000"/>
    <UFC max_credits="2M" min_threshold="0.4"/>
    <MFC max_credits="2M" min_threshold="0.4"/>
    <FRAG2 frag_size="60K"/>
</config>
