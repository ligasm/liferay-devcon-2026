<!-- S1 — Hygiene: $CATALINA_HOME/conf/web.xml, the "jsp" servlet.
     development=false  → stop re-checking ROOT's JSPs every 4 s (module JSPs already
                          run with it off, in Liferay's own JspServlet)
     mappedfile=false   → stop generating one out.write() per JSP source line
     Recommended by Liferay's "Tuning Liferay" page, which prints `mappedFile`. Jasper
     reads the lowercase `mappedfile`, so the documented spelling is ignored (read from
     source and the shipped jar, not run).
     matrix/local/apply-stage.sh does not apply this file, so the measured S1 runs did
     not test either setting. Restart Tomcat and clear work/ after changing. -->
<servlet>
    <servlet-name>jsp</servlet-name>
    <servlet-class>org.apache.jasper.servlet.JspServlet</servlet-class>
    <init-param>
        <param-name>fork</param-name>
        <param-value>false</param-value>
    </init-param>
    <init-param>
        <param-name>development</param-name>
        <param-value>false</param-value>
    </init-param>
    <init-param>
        <param-name>mappedfile</param-name>
        <param-value>false</param-value>
    </init-param>
    <init-param>
        <param-name>genStringAsCharArray</param-name>
        <param-value>true</param-value>
    </init-param>
    <init-param>
        <param-name>trimSpaces</param-name>
        <param-value>true</param-value>
    </init-param>
    <load-on-startup>3</load-on-startup>
</servlet>
