# Documents & Media → Cache Control (System Settings → Documents and Media → Cache Control).
# PID and keys VERIFIED against DXP 2026.Q1 (com.liferay.document.library.web.jar,
# OSGI-INF/metatype/…CacheControlConfiguration.xml): cacheControl is one of
# "must-revalidate" (default) | "private, no-cache, no-store, must-revalidate" | "private" | "public";
# maxAge in seconds (default 600); notCacheableMimeTypes = MIME types that keep the default.
# Only files visible to the Guest role are affected.
cacheControl="public"
maxAge=I"86400"
notCacheableMimeTypes=[]
