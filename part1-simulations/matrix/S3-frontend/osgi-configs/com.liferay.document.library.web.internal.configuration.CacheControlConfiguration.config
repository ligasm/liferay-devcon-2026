# UNVERIFIED — check learn.liferay.com: PID and key names taken from a System
# Settings export pattern, not from the docs. Export your own instance's
# configuration (System Settings → Documents and Media → Cache Control → Export)
# and use that file. Only files visible to the Guest role are affected.
cacheControlPolicy="public"
maxAge=I"86400"
mimeTypeExclusions=["application/pdf"]
